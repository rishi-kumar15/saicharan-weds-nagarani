, 0.9));z-index:1"></div><div class="container" style="position:relative;z-index:2;text-align:center;display:flex;flex-direction:column;align-items:center;margin-top:0vh"><div style="display:flex;flex-direction:column;align-items:center;margin-bottom:2rem;opacity:0;transform:translateY(20px) scale(0.9)"><div style="display:inline-block;position:relative;margin-bottom:10px"><h2 style="font-family:&quot;Yatra One&quot;, cursive;font-size:clamp(4rem, 15vw, 7rem);color:#1a3b39;margin:0;line-height:1;padding-right:20px;text-shadow:0px 1px 2px rgba(255,255,255,0.9)">शुभ विवाह</h2></div><p class="font-serif" style="font-weight:bold;font-size:clamp(1rem, 3.5vw, 1.4rem);margin-top:0.6rem;color:#1a3b39;text-shadow:0px 1px 2px rgba(255,255,255,0.9);opacity:0;letter-spacing:0px">શાહ અને પટેલ પરિવાર ના આંગણે...</p></div><div style="display:flex;flex-direction:column;align-items:center;margin:2rem 0;opacity:0;transform:translateY(20px)"><h1 class="font-script" style="font-size:clamp(5rem, 15vw, 8.5rem);color:#1a3b39;line-height:1;text-shadow:0px 2px 4px rgba(255,255,255,0.8);margin:0">ઈશાની</h1><div style="display:flex;align-items:center;gap:15px;margin:15px 0"><div style="width:clamp(40px, 10vw, 80px);height:2px;background:linear-gradient(to right, transparent, #c19b6c)"></div><span style="font-family:&quot;Great Vibes&quot;, cursive;font-size:clamp(3rem, 8vw, 4.5rem);color:#c19b6c;line-height:0.8;text-shadow:0px 1px 2px rgba(255,255,255,0.8)">&amp;</span><div style="width:clamp(40px, 10vw, 80px);height:2px;background:linear-gradient(to left, transparent, #c19b6c)"></div></div><h1 class="font-script" style="font-size:clamp(5rem, 15vw, 8.5rem);color:#1a3b39;line-height:1;text-shadow:0px 2px 4px rgba(255,255,255,0.8);margin-top:10px">અદવૈત</h1></div></div><div class="flex flex-col items-center gap-2 select-none cursor-pointer active:scale-95 transition-all text-[#1a3b39]" style="position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);z-index:2;opacity:0"><div class="w-5 h-9 rounded-full border-2 border-[#1a3b39] flex items-start justify-center p-1 bg-white/10 backdrop-blur-[1px]"><div class="w-1 h-2 rounded-full bg-[#1a3b39]"></div></div><div><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-[#1a3b39]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></div></div></section><section id="couple-section" style="position:relative;padding:80px 0;background-color:#0a0a0a;color:#fff;overflow:hidden"><div class="container" style="position:relative;z-index:10;max-width:1100px;margin:0 auto;padding:0 20px"><div style="text-align:center;margin-bottom:60px;opacity:0;transform:translateY(50px)"><h2 style="font-family:var(--font-script);font-size:clamp(3rem, 8vw, 4.5rem);color:var(--color-gold);margin-bottom:10px">નવદંપતી</h2><p style="font-family:var(--font-serif);color:var(--color-gold-light);font-size:0.9rem;letter-spacing:4px;text-transform:uppercase;opacity:0.8">Meet the Couple</p><div style="width:80px;height:1px;background-color:var(--color-gold);margin:20px auto"></div></div><div style="display:flex;flex-direction:column;gap:60px"><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:40px;align-items:start"><div style="text-align:center;opacity:0;transform:translateX(-30px)"><div style="position:relative;width:260px;height:350px;margin:0 auto 30px;border:10px solid #fff;box-shadow:0 30px 60px rgba(0,0,0,0.6), 0 10px 20px rgba(0,0,0,0.4);background-color:#1a1a1a;transform:perspective(1000px) rotateY(0deg);transition:transform 0.5s ease"><img alt="અદવૈત પટેલ" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" src="/templates/wedding/advait-weds-ishani/shivam-single.png?dpl=dpl_D5jqm5B4htUuQvtgr8mDibsCdeMY"/></div><div style="padding:0 20px"><p style="color:var(--color-gold);font-size:0.85rem;font-style:italic;margin-bottom:15px">શ્રી ખોડિયાર માતાજીની અસીમ કૃપાથી...</p><p style="color:#fff;font-size:1.1rem;margin-bottom:10px">અમદાવાદ નિવાસી</p><div style="background-color:rgba(205,181,114,0.05);padding:20px;border-radius:15px;border-right:4px solid var(--color-gold);margin-bottom:20px"><p style="font-size:1.1rem;line-height:1.6">અ.સૌ. ગીતાબેન તથા દીપકભાઈ નવીનભાઈ પટેલ</p><p style="font-size:0.75rem;color:var(--color-gold);text-transform:uppercase;letter-spacing:2px;margin-top:10px">ના સુપુત્ર</p></div><h3 style="font-family:var(--font-script);font-size:3rem;color:var(--color-gold);margin:15px 0">અદવૈત પટેલ</h3><p style="font-size:0.75rem;color:var(--color-gold);text-transform:uppercase;letter-spacing:3px;font-weight:bold">The Groom</p></div></div><div style="text-align:center;opacity:0;transform:translateX(30px)"><div style="position:relative;width:260px;height:350px;margin:0 auto 30px;border:10px solid #fff;box-shadow:0 30px 60px rgba(0,0,0,0.6), 0 10px 20px rgba(0,0,0,0.4);background-color:#1a1a1a;transform:perspective(1000px) rotateY(0deg);transition:transform 0.5s ease"><img alt="ઈશાની શાહ" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" src="/templates/wedding/advait-weds-ishani/tanya-single.png?dpl=dpl_D5jqm5B4htUuQvtgr8mDibsCdeMY"/></div><div style="padding:0 20px"><p style="color:var(--color-gold);font-size:0.85rem;font-style:italic;margin-bottom:15px">શ્રી ગણેશાય નમઃની અસીમ કૃપાથી...</p><p style="color:#fff;font-size:1.1rem;margin-bottom:10px">અમદાવાદ નિવાસી</p><div style="background-color:rgba(205,181,114,0.05);padding:20px;border-radius:15px;border-left:4px solid var(--color-gold);margin-bottom:20px"><p style="font-size:1.1rem;line-height:1.6">અ.સૌ. સુષમાબેન તથા વિજયભાઈ કિશોરભાઈ શાહ</p><p style="font-size:0.75rem;color:var(--color-gold);text-transform:uppercase;letter-spacing:2px;margin-top:10px">ની સુપુત્રી</p></div><h3 style="font-family:var(--font-script);font-size:3rem;color:var(--color-gold);margin:15px 0">ઈશાની શાહ</h3><p style="font-size:0.75rem;color:var(--color-gold);text-transform:uppercase;letter-spacing:3px;font-weight:bold">The Bride</p></div></div></div></div><div style="margin-top:80px;text-align:center;opacity:0"><div style="font-size:1.5rem;font-style:italic;color:var(--color-gold-light);max-width:800px;margin:0 auto;line-height:1.6;opacity:0.9">&quot;<!-- -->પ્રેમ એક અદભૂત અહેસાસ છે, જે બે આત્માઓને એક કરે છે અને જીવનને સુંદર બનાવે છે.<!-- -->&quot;</div></div></div></section><section class="section-padding" style="background:var(--color-sage-light);position:relative"><div class="container" style="text-align:center"><div style="opacity:0;transform:translateY(40px)"><h2 class="font-script" style="font-size:clamp(3rem, 8vw, 4.5rem);margin-bottom:1rem;color:var(--color-primary-dark)">અમારા નવા સફરની મંગલ શરૂઆત...</h2><div style="max-width:600px;margin:0 auto 3rem auto"><p class="font-sans" style="line-height:1.6;color:var(--color-text-dark);font-size:1.2rem;font-weight:500">સમયની દરેક પળ સાથે, અમારા મિલનની ખુશીઓ અને ઉત્સાહ વધી રહ્યો છે...</p></div><span>લગ્નનો દિવસ આવી ગયો છે!</span></div></div></section><section class="section-padding" style="background:var(--color-blush)"><div class="container"><div style="text-align:center;opacity:0"><h2 class="font-script" style="text-align:center;font-size:3.5rem;margin-bottom:3rem;color:var(--color-text-dark)">માંગલિક પ્રસંગો</h2></div><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 300px), 1fr));gap:1.5rem"><div class="glass" style="padding:3rem 2rem;border-radius:24px;text-align:center;background-image:linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.8)), url(/templates/wedding/advait-weds-ishani/images/event1.png);background-size:cover;background-position:center;overflow:hidden;color:white;border:1px solid rgba(255, 215, 0, 0.2);box-shadow:0 20px 40px rgba(0,0,0,0.3);opacity:0;transform:translateY(30px)"><h3 class="font-serif" style="font-size:2rem;margin-bottom:1rem;color:var(--color-gold);text-shadow:0 2px 4px rgba(0,0,0,0.5)">મહેંદી</h3><p class="font-serif" style="margin-bottom:1.5rem;color:rgba(255,255,255,0.95);line-height:1.6;text-shadow:0 1px 2px rgba(0,0,0,0.5)">સુરતના સુંદર ફાર્મના આંગણે, મહેંદીના શુકનવંતા રંગો સાથે શરૂ થશે અમારા નવા જીવનની મીઠી સફર.</p><div style="display:flex;flex-direction:column;gap:1rem;align-items:center"><div class="flex-center" style="gap:10px"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><span class="font-sans" style="letter-spacing:1px;text-shadow:0 1px 2px rgba(0,0,0,0.5)">સવારે ૧૦:૦0 કલાકે</span></div><a href="https://www.google.com/maps/search/?api=1&amp;query=Vrindavan+Farm+Surat" target="_blank" rel="noopener noreferrer" class="flex-center" style="gap:15px;margin-top:1rem;text-decoration:none;color:inherit"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin" aria-hidden="true" style="flex-shrink:0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg><div style="text-align:left;text-shadow:0 1px 2px rgba(0,0,0,0.5)"><div style="font-weight:600;color:#fff">વૃંદાવન ફાર્મ (Vrindavan Farm)</div><div style="font-size:0.9rem;color:rgba(255,255,255,0.8);margin-top:4px">ડુમસ રોડ, સુરત (Dumas Road, Surat)</div></div></a></div></div><div class="glass" style="padding:3rem 2rem;border-radius:24px;text-align:center;background-image:linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.8)), url(/templates/wedding/advait-weds-ishani/images/event2.png);background-size:cover;background-position:center;overflow:hidden;color:white;border:1px solid rgba(255, 215, 0, 0.2);box-shadow:0 20px 40px rgba(0,0,0,0.3);opacity:0;transform:translateY(30px)"><h3 class="font-serif" style="font-size:2rem;margin-bottom:1rem;color:var(--color-gold);text-shadow:0 2px 4px rgba(0,0,0,0.5)">ગીત ગુંજન</h3><p class="font-serif" style="margin-bottom:1.5rem;color:rgba(255,255,255,0.95);line-height:1.6;text-shadow:0 1px 2px rgba(0,0,0,0.5)">સુમધુર લગ્નગીતોના સથવારે અને સુરમય વાતાવરણમાં, આવો સંગીતના સૂરો સાથે આપણી ખુશીઓને બમણી કરીએ.</p><div style="display:flex;flex-direction:column;gap:1rem;align-items:center"><div class="flex-center" style="gap:10px"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><span class="font-sans" style="letter-spacing:1px;text-shadow:0 1px 2px rgba(0,0,0,0.5)">સાંજે ૮:૩૦ કલાકે</span></div><a href="https://www.google.com/maps/search/?api=1&amp;query=Vrindavan+Farm+Surat" target="_blank" rel="noopener noreferrer" class="flex-center" style="gap:15px;margin-top:1rem;text-decoration:none;color:inherit"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin" aria-hidden="true" style="flex-shrink:0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg><div style="text-align:left;text-shadow:0 1px 2px rgba(0,0,0,0.5)"><div style="font-weight:600;color:#fff">વૃંદાવન ફાર્મ (Vrindavan Farm)</div><d