on\\\",\\\"target\\\":\\\"https://www.dreamsinvite.com/templates?q={search_term_string}\\\",\\\"query-input\\\":\\\"required name=search_term_string\\\"}}\"}}]\n4:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"name\\\":\\\"Dreams Invite\\\",\\\"url\\\":\\\"https://www.dreamsinvite.com/\\\",\\\"description\\\":\\\"Premium digital wedding invitation websites and animated invitation designs.\\\",\\\"isPartOf\\\":{\\\"@id\\\":\\\"https://www.dreamsinvite.com/#website\\\"},\\\"about\\\":{\\\"@id\\\":\\\"https://www.dreamsinvite.com/#organization\\\"}}\"}}]\n5:[\"$\",\"$L13\",null,{}]\n14:Tc6b,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Digital Wedding Website Invitation Design\",\"serviceType\":\"Digital Wedding Website Invitation Design\",\"provider\":{\"@id\":\"https://www.dreamsinvite.com/#organization\"},\"areaServed\":\"IN\",\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"5.0\",\"reviewCount\":\"5\",\"bestRating\":\"5\",\"worstRating\":\"1\"},\"review\":[{\"@type\":\"Review\",\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\"},\"author\":{\"@type\":\"Person\",\"name\":\"Drashti Shah\"},\"datePublished\":\"2026-06-17\",\"reviewBody\":\"From start to finish, the entire process was seamless and enjoyable. The design options were beautiful, easy to customize, and perfectly matched our wedding theme. Our invitation turned out elegant, unique, and truly unforgettable. We received countless compliments from guests, and many asked where we got it designed. Highly recommended for couples who want a stylish and hassle-free wedding invitation experience!\"},{\"@type\":\"Review\",\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\"},\"author\":{\"@type\":\"Person\",\"name\":\"Hida Mariyam\"},\"datePublished\":\"2026-06-16\",\"reviewBody\":\"I randomly sent DreamsInvite a DM did not expect such good work absolutely amazing!! The work they do is great! Akshit busa did a commendable job. Special occasions like these are meant to be perfect. He made it exactly how I wanted, did it very patiently. Glad I found their page. Thanks!\"},{\"@type\":\"Review\",\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\"},\"author\":{\"@type\":\"Person\",\"name\":\"Prathmesh Magdum\"},\"datePublished\":\"2026-06-16\",\"reviewBody\":\"Absolutely loved the experience! Customizing our wedding invitation was simple, and the final result looked stunning. We received so many compliments from our family and friends. Highly recommended for anyone looking to create a memorable wedding invitation!\"},{\"@type\":\"Review\",\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\"},\"author\":{\"@type\":\"Person\",\"name\":\"Bhavesh Charaniya\"},\"datePublished\":\"2026-06-12\",\"reviewBody\":\"We are absolutely delighted with our wedding invitation! The design was elegant, premium, and beautifully captured the essence of our special day. The team delivered a stunning invitation that exceeded our expectations and received countless compliments from our guests.\"}],\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Dreams Invite Wedding Invitation Plans\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Basic Digital Wedding Invitation\",\"description\":\"Standard animated design, single page layout, background music, basic RSVP, and WhatsApp share link.\"},\"price\":\"2499\",\"priceCurrency\":\"INR\"},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Premium Cinematic Wedding Invitation\",\"description\":\"Cinematic animations, custom music, live RSVP dashboard, countdown timer, guest wishes wall, and lifetime link.\"},\"price\":\"3999\",\"priceCurrency\":\"INR\"},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Custom Bespoke Wedding Invitation\",\"description\":\"Fully custom design with 3D assets, multi-page layout, personalized domain, and dedicated designer.\"}}]}}"])</script><script>self.__next_f.push([1,"6:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$14\"}}]\n7:[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://fonts.googleapis.com\"}]\n8:[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://fonts.gstatic.com\",\"crossOrigin\":\"anonymous\"}]\n9:[\"$\",\"link\",null,{\"href\":\"/fonts/fonts.css\",\"rel\":\"stylesheet\"}]\na:[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"\\n          :root {\\n            --font-poppins: 'Poppins', sans-serif;\\n            --font-playfair: 'Playfair Display', serif;\\n            --font-cinzel: 'Cinzel', serif;\\n            --font-cormorant: 'Cormorant Garamond', serif;\\n          }\\n        \"}}]\n15:[\"$\",\"iframe\",null,{\"src\":\"https://www.googletagmanager.com/ns.html?id=GTM-TSFFNJBF\",\"height\":\"0\",\"width\":\"0\",\"style\":{\"display\":\"none\",\"visibility\":\"hidden\"}}]\n"])</script><script>self.__next_f.push([1,"b:[\"$\",\"body\",null,{\"className\":\"antialiased\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"noscript\",null,{\"children\":\"$15\"}],[\"$\",\"$L16\",null,{}],[\"$\",\"$L17\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L18\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirect