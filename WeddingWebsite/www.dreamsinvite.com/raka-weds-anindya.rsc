lucide-clock w-4 h-4 text-gold" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>16.00 — 21.00 WIB</li><li class="flex flex-col items-center gap-1 text-foreground/80"><span class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-4 h-4 text-gold" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg> <!-- -->The Olive Garden</span><span class="text-xs text-muted-foreground">Jl. Tirta Kencana No. 17, Yogyakarta</span></li></ul><a href="https://maps.google.com/?q=The%20Olive%20Garden%20Jl.%20Tirta%20Kencana%20No.%2017%2C%20Yogyakarta" target="_blank" rel="noopener noreferrer" class="inline-block mt-7 px-6 py-2.5 text-xs tracking-[0.3em] uppercase border border-primary/40 text-primary hover:bg-primary hover:text-primary-foreground transition-colors">View Map</a></div></div></div></section><section id="gift" class="relative py-24 sm:py-32 px-6"><div class="max-w-3xl mx-auto"><div class="text-center mb-12 sm:mb-16"><p class="section-eyebrow mb-4" style="opacity:0;transform:translateY(10px)">With Gratitude</p><h2 class="font-display text-4xl sm:text-5xl md:text-6xl text-primary italic flex flex-wrap justify-center gap-x-3"><span class="inline-block" style="opacity:0;filter:blur(6px);transform:translateY(24px)">Wedding</span><span class="inline-block" style="opacity:0;filter:blur(6px);transform:translateY(24px)">Gift</span></h2><div class="gold-rule w-24 mx-auto mt-5 origin-center" style="opacity:0;transform:scaleX(0)"></div><p class="mt-5 max-w-xl mx-auto text-muted-foreground text-sm sm:text-base leading-relaxed" style="opacity:0;transform:translateY(10px)">Your prayers are the greatest gift. Should you wish to send a token of love, we humbly provide the following.</p></div><div class="grid sm:grid-cols-2 gap-6"><div class="ornament-frame p-7" style="opacity:0;transform:translateY(20px)"><div class="flex items-center justify-between"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gift w-5 h-5 text-gold" aria-hidden="true"><path d="M12 7v14"></path><path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"></path><rect x="3" y="7" width="18" height="4" rx="1"></rect></svg><span class="section-eyebrow">BCA</span></div><div class="mt-5 font-display italic text-2xl text-primary">Anindya Putri</div><div class="mt-1 font-mono text-lg tracking-wider text-foreground/80">1234567890</div><button class="mt-5 inline-flex items-center gap-2 text-xs tracking-[0.3em] uppercase text-primary hover:text-accent transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy w-3.5 h-3.5" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>Copy Number</button></div><div class="ornament-frame p-7" style="opacity:0;transform:translateY(20px)"><div class="flex items-center justify-between"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gift w-5 h-5 text-gold" aria-hidden="true"><path d="M12 7v14"></path><path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"></path><rect x=